{
  "name": "roshan-blog-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --ignore dist --exec \"ts-node --files --require tsconfig-paths/register src/index.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node --require ./dist/register-paths.js dist/index.js",
    "db:migrate": "npm run build && node --require ./dist/register-paths.js dist/database/migrate.js",
    "db:seed-admin": "npm run build && node --require ./dist/register-paths.js dist/database/seed-admin.js",
    "db:backfill-chapters": "npm run build && node --require ./dist/register-paths.js dist/database/backfill-chapters.js",
    "db:migrate:prod": "node --require ./dist/register-paths.js dist/database/migrate.js",
    "db:seed-admin:prod": "node --require ./dist/register-paths.js dist/database/seed-admin.js",
    "db:backfill-chapters:prod": "node --require ./dist/register-paths.js dist/database/backfill-chapters.js",
    "test": "npm run build && NODE_ENV=test node --require ./dist/register-paths.js --test --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "test:watch": "npm run build && NODE_ENV=test node --require ./dist/register-paths.js --test --watch --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "test:coverage": "npm run build && NODE_ENV=test node --require ./dist/register-paths.js --test --experimental-test-coverage --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "deploy:build": "npm ci && npm run build && npm prune --omit=dev"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@types/sanitize-html": "^2.16.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "file-type": "^16.5.4",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.16.0",
    "sanitize-html": "^2.17.6",
    "sequelize": "^6.32.1",
    "sequelize-typescript": "^2.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.5.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
