PORT=4000
NODE_ENV=development

# Number of reverse-proxy hops in front of the app (app.set("trust proxy", …)).
# Defaults to 0 in development and 1 in production. Set to the exact hop count
# for your topology (e.g. 1 behind a single nginx/Cloudflare/Render/Fly proxy).
# Do NOT set this to a value that trusts more hops than exist — that lets
# clients spoof X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT (use long random strings in production)
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Public URL used to build media URLs (no trailing slash)
MEDIA_BASE_URL=http://localhost:4000

# Public app/API URLs used in newsletter links (no trailing slash)
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Newsletter email provider
# EMAIL_PROVIDER: "resend" (default when RESEND_API_KEY is set) or "console".
# Use "console" for offline/local dev — emails are logged to the server console
# instead of being sent over the network.
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Your Blog <newsletter@your-verified-domain.com>"
NEWSLETTER_EMAIL_RATE_LIMIT_PER_SECOND=2

# Contact form — email address that receives contact form submissions
CONTACT_EMAIL=contact@your-domain.com

# Used only during database seeding (npm run db:seed-admin)
# Change these before running the seeder in production
ADMIN_EMAIL=admin@caroshan.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=CA Roshan

## Feature flags
# "1"/"true" = on, "0" or unset = off (default off). Read at runtime, so
# flipping it requires only a backend restart.
FEATURE_FLAG_CONTACT_PAGE=0

# Managed Postgres connection string. When set, it overrides the DB_* fields
# above and enables TLS in production.
DATABASE_URL=
DB_POOL_MAX=10

# TLS to the database. DB_SSL defaults to on whenever DATABASE_URL is set or
# NODE_ENV is production/staging; set DB_SSL=false only for a plaintext local
# Postgres.
DB_SSL=true
# Verify the database server's certificate. Defaults to true and is forced to
# true in production/staging — DB_SSL_VERIFY=false is honoured only in
# development/test, for a local server with a self-signed certificate.
DB_SSL_VERIFY=true
# PEM contents of the provider's CA certificate, when it is not in the system
# trust store. Optional.
DB_SSL_CA=

# Media storage: "local" (dev only, ephemeral on container hosts) or
# "cloudinary". Defaults to cloudinary in production and staging.
MEDIA_STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ca-roshan-blog
